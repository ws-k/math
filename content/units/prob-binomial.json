      "q": "확률변수 $X$ 가 이항분포 $\\mathrm{B}(n,\\ p)$ 를 따르고 $E(X)=4$, $E(X^2)=18$ 일 때, $P(X=1)$ 의 값은?",
      "choices": [
        "$\\frac{1}{128}$",
        "$\\frac{1}{64}$",
        "$\\frac{3}{64}$",
        "$\\frac{1}{32}$",
        "$\\frac{1}{16}$"
      ],
      "answer": "4",
      "answerType": "choice",
      "check": "e = 4\nv = 18 - e**2\npp = 1 - Rational(v, e)\nn0 = e/pp\nans = binomial(n0, 1)*pp*(1 - pp)**(n0 - 1)",
      "choiceChecks": [
        "Rational(1, 128)",
        "Rational(1, 64)",
        "Rational(3, 64)",
        "Rational(1, 32)",
        "Rational(1, 16)"
      ],
      "concepts": [
        "$E(X)=np$, $V(X)=np(1-p)$",
        "$P(X=r)={}_n\\mathrm{C}_r\\,p^r(1-p)^{n-r}$",
        "$V(X)=E(X^2)-\\{E(X)\\}^2$"
      ],
      "steps": [
        {
          "title": "분산",
          "body": "$$V(X)=18-4^2=2$$"
        },
        {
          "title": "$p$",
          "body": "$1-p=\\frac{2}{4}=\\frac{1}{2}$ 이므로 $p=\\frac{1}{2}$ 이에요."
        },
        {
          "title": "$n$",
          "body": "$n\\times\\frac{1}{2}=4$ 이므로 $n=8$ 이에요."
        },
        {
          "title": "$P(X=1)$",
          "body": "$$P(X=1)={}_8\\mathrm{C}_1\\left(\\frac{1}{2}\\right)^1\\left(\\frac{1}{2}\\right)^7=\\frac{8}{256}=\\frac{1}{32}$$"
        }
      ],
      "tip": "$E(X^2)$ 에서 분산을 꺼내는 단계가 이 문제의 열쇠예요."
    }
  ]
